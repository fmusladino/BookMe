# Copiar a .env.test.local y llenar con valores reales para correr los tests E2E
# contra un usuario de prueba existente en la DB.

# URL del entorno a testear (dev local por default)
E2E_BASE_URL=http://localhost:3000

# Usuario profesional de prueba (para login tests)
E2E_PROFESSIONAL_EMAIL=
E2E_PROFESSIONAL_PASSWORD=
E2E_PROFESSIONAL_SLUG=

# Usuario paciente de prueba
E2E_PATIENT_EMAIL=
E2E_PATIENT_PASSWORD=
